# -----------------------------------------------------------------------------
# Secrets and machine-specific configuration
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
**/key.properties
**/local.properties
**/google-services.json
**/GoogleService-Info.plist

# Signing material and distributable binaries are produced locally.
/release/
*.apk
*.aab
*.ipa

# -----------------------------------------------------------------------------
# Flutter / Dart
# -----------------------------------------------------------------------------
**/.dart_tool/
**/.pub-cache/
**/.pub/
**/.packages
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/build/
**/coverage/
**/doc/api/
**/ios/Flutter/.last_build_id
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/GeneratedPluginRegistrant.java
*.symbols
*.map.json

# Keep pubspec.lock: this repository contains an application, not a package.

# -----------------------------------------------------------------------------
# Android / Gradle
# -----------------------------------------------------------------------------
**/.gradle/
**/.cxx/
**/captures/
*.class

# Keep gradlew, gradlew.bat, gradle-wrapper.jar and gradle-wrapper.properties:
# they make Android builds reproducible on machines without a global Gradle.

# -----------------------------------------------------------------------------
# Local SDKs, caches and generated tooling state
# -----------------------------------------------------------------------------
/.config/
/.local/
/.toolchains
/.toolchains/
/.flutter-sdk/
/.home/
/.build-cache/
/.dart-tool/
/.dartServer/
/.flutter

